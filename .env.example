# Copy to .env and fill in. Loaded by the systemd unit (EnvironmentFile).

# ThingsBoard REST base + a dedicated read-only user for the watcher
TB_HOST=https://nonthaburi.info
TB_USER=alarmwatcher@nonthaburi.info
TB_PASS=change-me

# How often to poll active alarms (seconds)
POLL_SECONDS=20

# Where to bind (Kong upstream points here). Keep on localhost.
BIND_HOST=127.0.0.1
PORT=7082

# VAPID contact (shown to push services); any mailto you own
VAPID_SUBJECT=mailto:admin@nonthaburi.info

# Directory for vapid_private.pem + subscriptions.json (persist across restarts)
DATA_DIR=/var/lib/alarm-push