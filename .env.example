# Copy to .env and fill in. Read by docker-compose (env_file) and, if you run the
# service on the host instead, by the systemd unit (EnvironmentFile).

# ThingsBoard REST base + a dedicated read-only user for the watcher
TB_HOST=https://nonthaburi.info
TB_USER=alarmwatcher@nonthaburi.info
TB_PASS=change-me

# How often to poll active alarms (seconds)
POLL_SECONDS=20

# Where to bind. Under Docker these are forced to 0.0.0.0:7082 by
# docker-compose.pushbridge.yml (no host port is published — only Kong can reach it).
# Running on the host instead? Keep BIND_HOST on localhost.
BIND_HOST=127.0.0.1
PORT=7082

# VAPID contact (shown to push services); any mailto you own
VAPID_SUBJECT=mailto:admin@nonthaburi.info

# Access token of the ThingsBoard "PWA Usage" device. /track stores usage events there.
# Leave empty to disable usage tracking.
USAGE_DEVICE_TOKEN=

# Directory for vapid_private.pem + subscriptions.json (persist across restarts).
# Under Docker this path is bind-mounted from the host at the same location.
DATA_DIR=/var/lib/pushbridge
