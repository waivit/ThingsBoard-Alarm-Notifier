[Unit]
Description=pushbridge — ThingsBoard alarm -> Web Push bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# adjust paths to where you cloned this
WorkingDirectory=/opt/pushbridge
EnvironmentFile=/opt/pushbridge/.env
ExecStart=/opt/pushbridge/.venv/bin/python /opt/pushbridge/main.py
Restart=always
RestartSec=5
# DATA_DIR must be writable by this user (vapid key + subscriptions live there)
StateDirectory=pushbridge

[Install]
WantedBy=multi-user.target
